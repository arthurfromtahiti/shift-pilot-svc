{
  "name": "prox-i/shift-pilot-svc",
  "description": "Service pilote SHIFT — application PHP réellement servie, avec base de données et canal de déploiement.",
  "type": "project",
  "require": { "php": ">=8.1", "ext-pdo": "*", "ext-pdo_sqlite": "*" },
  "require-dev": { "phpunit/phpunit": "^10.5" },
  "autoload": { "psr-4": { "App\\": "src/" } },
  "scripts": {
    "test": "phpunit --colors=never",
    "migrate": "php bin/migrate.php",
    "migrate:dry": "php bin/migrate.php --dry-run"
  },
  "config": { "platform": { "php": "8.1.0" } }
}
